<UserControl x:Class="ColumnPadStudio.Controls.ColumnEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ColumnPadStudio.Controls"
             MinWidth="220"
             Foreground="{DynamicResource ControlForegroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Border Background="{DynamicResource EditorBackgroundBrush}"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                </Style>
            </Border.Style>
            <DockPanel>
            <Border x:Name="HeaderGrip"
                    DockPanel.Dock="Top"
                    Padding="6,4"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ColumnHeaderBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ColumnSelectedHeaderBackgroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu Opened="ColumnContextMenu_Opened"
                                 Placement="Bottom">
                        <MenuItem Header="Rename Column" Click="ColumnMenuRename_Click"/>
                        <MenuItem Header="Delete Column" Click="ColumnMenuDelete_Click"/>
                        <MenuItem Header="Swap with Column on Left"
                                  Click="ColumnMenuMoveLeft_Click"
                                  InputGestureText="Alt+Shift+Left"
                                  IsEnabled="{Binding PlacementTarget.DataContext.CanMoveLeft, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Swap with Column on Right"
                                  Click="ColumnMenuMoveRight_Click"
                                  InputGestureText="Alt+Shift+Right"
                                  IsEnabled="{Binding PlacementTarget.DataContext.CanMoveRight, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Reset This Column Size" Click="ColumnMenuResetWidth_Click"/>
                        <MenuItem Header="Resize This Column..." Click="ColumnMenuResize_Click"/>
                        <MenuItem Header="Insert Picture..." Click="InsertPicture_Click"/>
                        <MenuItem x:Name="ColumnPicturesMenuItem" Header="Pictures"/>
                        <MenuItem Header="{Binding PlacementTarget.DataContext.WidthLockActionLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  ToolTip="{Binding PlacementTarget.DataContext.WidthLockActionToolTip, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Click="ColumnMenuToggleWidthLock_Click"/>
                        <Separator/>
                        <MenuItem Header="Column Font Settings">
                            <MenuItem Header="Set Font Family..." Click="ColumnFontSetFamily_Click"/>
                            <MenuItem Header="Increase Font Size" Click="ColumnFontIncrease_Click"/>
                            <MenuItem Header="Decrease Font Size" Click="ColumnFontDecrease_Click"/>
                            <MenuItem x:Name="ColumnFontBoldMenuItem"
                                      Header="Bold"
                                      IsCheckable="True"
                                      Click="ColumnFontBold_Click"/>
                            <MenuItem x:Name="ColumnFontItalicMenuItem"
                                      Header="Italic"
                                      IsCheckable="True"
                                      Click="ColumnFontItalic_Click"/>
                            <Separator/>
                            <MenuItem Header="Use Workspace Font" Click="ColumnFontReset_Click"/>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <controls:InlineRenameText Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   IsEditing="{Binding IsRenaming, Mode=TwoWay}"
                                                   Margin="2,0,0,0"/>
                        <TextBlock Text="{Binding MetricsText}"
                                   Margin="2,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource LineNumberForegroundBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStandaloneDocument}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource CompactButtonStyle}"
                                Margin="0,0,4,0"
                                Click="ColumnMenuMoveLeft_Click"
                                Content="Swap Left"
                                ToolTip="Swap this column with the column on the left."
                                IsEnabled="{Binding CanMoveLeft}"/>
                        <Button Style="{StaticResource CompactButtonStyle}"
                                Click="ColumnMenuMoveRight_Click"
                                Content="Swap Right"
                                ToolTip="Swap this column with the column on the right."
                                IsEnabled="{Binding CanMoveRight}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="EditorSurface"
                  Background="{DynamicResource EditorBackgroundBrush}"
                  SnapsToDevicePixels="True"
                  ClipToBounds="True"
                  AllowDrop="True"
                  PreviewDragOver="EditorSurface_DragOver"
                  PreviewDrop="EditorSurface_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding LineNumberColumnWidth}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="LineNumberGutter"
                        Grid.Column="0"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="0,0,1,0"
                        SnapsToDevicePixels="True"
                        ClipToBounds="True"
                        Visibility="{Binding ShowLineNumbersVisibility}"
                        PreviewMouseLeftButtonDown="LineNumbers_PreviewMouseLeftButtonDown"
                        PreviewMouseRightButtonDown="LineNumbers_PreviewMouseRightButtonDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource LineNumberBackgroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.ActiveVm.LinedPaperEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource EditorLinedPaperBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.ContextMenu>
                        <ContextMenu Opened="LineNumbersContextMenu_Opened">
                            <MenuItem x:Name="LineMarkerNumbersMenuItem" Header="Numbers" IsCheckable="True" Click="LineMarkerNumbers_Click"/>
                            <MenuItem x:Name="LineMarkerBulletsMenuItem" Header="Bullets" IsCheckable="True" Click="LineMarkerBullets_Click"/>
                            <MenuItem x:Name="LineMarkerChecklistMenuItem" Header="Checklist" IsCheckable="True" Click="LineMarkerChecklist_Click"/>
                            <Separator/>
                            <MenuItem x:Name="LineMarkerToggleCheckMenuItem" Header="Toggle Check" Click="LineMarkerToggleCheck_Click"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <TextBlock x:Name="LineNumbers"
                               IsHitTestVisible="False"
                               FontFamily="{Binding EditorFontFamily}"
                               FontSize="{Binding LineNumberFontSize}"
                               Foreground="{DynamicResource LineNumberForegroundBrush}"
                               Padding="6,0,5,0"
                               TextAlignment="Right"
                               TextWrapping="NoWrap"
                               LineHeight="{Binding EditorLineHeight}"
                               LineStackingStrategy="BlockLineHeight"
                               TextOptions.TextFormattingMode="Display"
                               Text="1">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="LineNumbersTransform"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Border>

                <Border Grid.Column="1"
                        Panel.ZIndex="0"
                        Background="{DynamicResource EditorBackgroundBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource EditorBackgroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.ActiveVm.LinedPaperEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource EditorLinedPaperBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <ItemsControl Grid.Column="1"
                              Panel.ZIndex="1"
                              IsHitTestVisible="False"
                              ItemsSource="{Binding Images}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding Width}"
                                  Height="{Binding Height}"
                                  Visibility="{Binding BehindTextVisibility}">
                                <Image Source="{Binding DisplaySource}"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True"/>
                                <Border Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanDisplayImage}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Margin="8"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Text="Picture could not be loaded"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox x:Name="Editor"
                         Grid.Column="1"
                         Panel.ZIndex="2"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{Binding EditorFontFamily}"
                         FontSize="{Binding EditorFontSize}"
                         FontStyle="{Binding EditorFontStyle}"
                         FontWeight="{Binding EditorFontWeight}"
                         Foreground="{DynamicResource EditorForegroundBrush}"
                         SelectionBrush="{DynamicResource EditorSelectionBrush}"
                         SelectionTextBrush="{DynamicResource EditorSelectionTextBrush}"
                         SelectionOpacity="1"
                         IsInactiveSelectionHighlightEnabled="False"
                         CaretBrush="{DynamicResource EditorForegroundBrush}"
                         TextWrapping="{Binding TextWrappingMode}"
                         VerticalContentAlignment="Top"
                         TextBlock.LineHeight="{Binding EditorLineHeight}"
                         TextBlock.LineStackingStrategy="BlockLineHeight"
                         HorizontalScrollBarVisibility="{Binding HorizontalScrollBarMode}"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         BorderThickness="0"
                         Padding="8,0,8,0"
                         TextOptions.TextFormattingMode="Display"
                         SpellCheck.IsEnabled="{Binding DataContext.ActiveVm.SpellCheckEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                         Language="{Binding DataContext.ActiveVm.EditorLanguageTag, RelativeSource={RelativeSource AncestorType=Window}, ConverterCulture=en-US}"
                         GotFocus="Editor_GotFocus"
                         TextChanged="Editor_TextChanged"
                         SizeChanged="Editor_SizeChanged"
                         CommandManager.PreviewExecuted="Editor_PreviewExecuted"
                         PreviewKeyDown="Editor_PreviewKeyDown"
                         PreviewMouseRightButtonDown="Editor_PreviewMouseRightButtonDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource EditorTextBoxStyle}">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </TextBox.Style>
                    <TextBox.ContextMenu>
                        <ContextMenu Opened="EditorContextMenu_Opened">
                            <MenuItem Header="Undo"
                                      Command="ApplicationCommands.Undo"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Cut"
                                      Command="ApplicationCommands.Cut"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Copy"
                                      Command="ApplicationCommands.Copy"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Paste"
                                      Command="ApplicationCommands.Paste"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Insert Picture..." Click="InsertPicture_Click"/>
                            <MenuItem Header="Delete"
                                      Command="ApplicationCommands.Delete"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Select All"
                                      Command="ApplicationCommands.SelectAll"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Done Selecting" Click="ClearSelection_Click" InputGestureText="Esc"/>
                            <Separator/>
                            <MenuItem Header="Paste Text As" Tag="PastePresetMenu">
                                <MenuItem Header="Plain Text" Tag="None" IsCheckable="True" Click="PastePresetNone_Click"/>
                                <MenuItem Header="Markdown Bullets" Tag="Bullets" IsCheckable="True" Click="PastePresetBullets_Click"/>
                                <MenuItem Header="Markdown Checklist" Tag="Checklist" IsCheckable="True" Click="PastePresetChecklist_Click"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Gutter: Bullets" Click="ToggleBullets_Click"/>
                            <MenuItem Header="Gutter: Checklist" Click="ToggleChecklist_Click"/>
                            <MenuItem Header="Gutter: Toggle Check" Click="ToggleCheckMarks_Click"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>

                <ItemsControl x:Name="ImageOverlay"
                              Grid.Column="1"
                              Panel.ZIndex="3"
                              ClipToBounds="True"
                              ItemsSource="{Binding Images}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding Width}"
                                  Height="{Binding Height}"
                                  Visibility="{Binding OverlayVisibility}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding PlacementTarget.DataContext.LayerActionText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Click="ImageToggleLayer_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Remove Picture"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Click="ImageRemove_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Image x:Name="Picture"
                                           Source="{Binding DisplaySource}"
                                           Stretch="Uniform"
                                           SnapsToDevicePixels="True"/>
                                <Border Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanDisplayImage}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Margin="8"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Text="Picture could not be loaded"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <Border BorderBrush="{DynamicResource ControlFocusBorderBrush}"
                                        BorderThickness="2"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding SelectionVisibility}"/>
                                <Thumb Background="Transparent"
                                       Cursor="SizeAll"
                                       Focusable="False"
                                       Tag="{Binding}"
                                       DragStarted="ImageMoveThumb_DragStarted"
                                       DragDelta="ImageMoveThumb_DragDelta">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb Width="14"
                                       Height="14"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Cursor="SizeNWSE"
                                       Focusable="False"
                                       Background="{DynamicResource ControlFocusBorderBrush}"
                                       Tag="{Binding}"
                                       Visibility="{Binding SelectionVisibility}"
                                       DragStarted="ImageResizeThumb_DragStarted"
                                       DragDelta="ImageResizeThumb_DragDelta"
                                       DragCompleted="ImageResizeThumb_DragCompleted"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            </DockPanel>
        </Border>

        <Thumb x:Name="RightEdgeResizeThumb"
               Width="6"
               HorizontalAlignment="Right"
               VerticalAlignment="Stretch"
               Cursor="SizeWE"
               Focusable="False"
               DragDelta="RightEdgeResizeThumb_DragDelta"
               Panel.ZIndex="10">
            <Thumb.Style>
                <Style TargetType="{x:Type Thumb}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsEnabled" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Background="Transparent"
                                        SnapsToDevicePixels="True"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStandaloneDocument}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWidthLocked}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Thumb.Style>
        </Thumb>
    </Grid>
</UserControl>


