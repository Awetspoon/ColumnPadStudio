<Window x:Class="ColumnPadStudio.Controls.WorkflowBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Builder"
        Width="1360"
        Height="820"
        MinWidth="1180"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ControlForegroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="WorkflowPanelBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        </Style>

        <Style x:Key="WorkflowSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="WorkflowMutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LineNumberForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="WorkflowNodeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WorkflowNodeAutoBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WorkflowNodeAutoBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Start">
                    <Setter Property="Background" Value="{DynamicResource WorkflowNodeGreenBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WorkflowNodeGreenBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Decision">
                    <Setter Property="Background" Value="{DynamicResource WorkflowNodeAmberBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WorkflowNodeAmberBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="End">
                    <Setter Property="Background" Value="{DynamicResource WorkflowNodeRoseBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WorkflowNodeRoseBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Note">
                    <Setter Property="Background" Value="{DynamicResource WorkflowNodeSlateBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WorkflowNodeSlateBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Color}" Value="Blue">
                    <Setter Property="Background" Value="{DynamicResource WorkflowNodeBlueBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WorkflowNodeBlueBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Color}" Value="Green">
                    <Setter Property="Background" Value="{DynamicResource WorkflowNodeGreenBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WorkflowNodeGreenBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Color}" Value="Amber">
                    <Setter Property="Background" Value="{DynamicResource WorkflowNodeAmberBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WorkflowNodeAmberBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Color}" Value="Rose">
                    <Setter Property="Background" Value="{DynamicResource WorkflowNodeRoseBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WorkflowNodeRoseBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Color}" Value="Slate">
                    <Setter Property="Background" Value="{DynamicResource WorkflowNodeSlateBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WorkflowNodeSlateBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlFocusBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="305"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="348"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource WorkflowPanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Workflow Library" Style="{StaticResource WorkflowSectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Add Workflow" Margin="0,0,4,0" Click="AddWorkflow_Click"/>
                        <Button Grid.Column="1" Content="Import JSON" Margin="4,0,0,0" Click="ImportWorkflowJson_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Workflow Starters" Style="{StaticResource WorkflowSectionTitleStyle}"/>
                        <Button DockPanel.Dock="Right"
                                Content="Create"
                                Width="68"
                                Click="UseStarter_Click"
                                IsEnabled="{Binding HasSelectedTemplate}"/>
                    </DockPanel>
                    <ListBox Height="185"
                             ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                             MouseDoubleClick="StarterList_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3,2,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource WorkflowMutedTextStyle}" FontSize="11"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Border Grid.Row="2" Margin="0,10,0,8" Height="1" Background="{DynamicResource ControlBorderBrush}"/>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="Saved Workflows" Style="{StaticResource WorkflowSectionTitleStyle}"/>
                    <ListBox MinHeight="170"
                             ItemsSource="{Binding Workflows}"
                             SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource WorkflowMutedTextStyle}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,8,0,0">
                    <TextBlock Text="{Binding SelectedWorkflowFileLabel}" Style="{StaticResource WorkflowMutedTextStyle}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Save" Margin="0,0,4,0" Click="SaveWorkflow_Click" IsEnabled="{Binding HasSelectedWorkflow}"/>
                        <Button Grid.Column="1" Content="Export" Margin="4,0" Click="ExportWorkflowJson_Click" IsEnabled="{Binding HasSelectedWorkflow}"/>
                        <Button Grid.Column="2" Content="Delete" Margin="4,0,0,0" Click="DeleteWorkflow_Click" IsEnabled="{Binding HasSelectedWorkflow}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="2" IsEnabled="{Binding HasSelectedWorkflow}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource WorkflowPanelBorderStyle}" Padding="8,6">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Start" Tag="Start" Width="54" Margin="0,0,4,0" Click="AddNodeOfKind_Click"/>
                        <Button Content="Step" Tag="Step" Width="50" Margin="0,0,4,0" Click="AddNodeOfKind_Click"/>
                        <Button Content="Decision" Tag="Decision" Width="72" Margin="0,0,4,0" Click="AddNodeOfKind_Click"/>
                        <Button Content="Note" Tag="Note" Width="50" Margin="0,0,4,0" Click="AddNodeOfKind_Click"/>
                        <Button Content="End" Tag="End" Width="48" Click="AddNodeOfKind_Click"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="{Binding SelectedWorkflow.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource WorkflowMutedTextStyle}" FontSize="11">
                            <Run Text="{Binding SelectedWorkflow.Category}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding SelectedWorkflow.Trigger}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource WorkflowPanelBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="8,8,8,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Canvas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Duplicate" Width="74" Margin="0,0,4,0" Click="DuplicateNode_Click" IsEnabled="{Binding HasSelectedNode}"/>
                            <Button Content="Remove Node" Width="102" Margin="0,0,4,0" Click="RemoveNode_Click" IsEnabled="{Binding HasSelectedNode}"/>
                            <Button Content="+ Link" Width="60" Margin="0,0,4,0" Click="AddLink_Click" IsEnabled="{Binding CanCreateLink}"/>
                            <Button Content="Auto Layout" Width="86" Click="AutoLayout_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="8"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="WorkflowDiagramSurface"
                              Width="{Binding DiagramCanvasWidth}"
                              Height="{Binding DiagramCanvasHeight}"
                              Background="{DynamicResource EditorBackgroundBrush}"
                              ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding LinkPreviews}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}">
                                                <Line.Style>
                                                    <Style TargetType="Line">
                                                        <Setter Property="Stroke" Value="{DynamicResource ControlFocusBorderBrush}"/>
                                                        <Setter Property="StrokeThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="StrokeThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Line.Style>
                                            </Line>
                                            <Path Data="M 0 0 L 6 4 L 0 8"
                                                  StrokeLineJoin="Miter"
                                                  Fill="Transparent"
                                                  Canvas.Left="{Binding X2}"
                                                  Canvas.Top="{Binding Y2}">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Stroke" Value="{DynamicResource ControlFocusBorderBrush}"/>
                                                        <Setter Property="StrokeThickness" Value="1.4"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="StrokeThickness" Value="2.2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{DynamicResource LineNumberForegroundBrush}"
                                                       FontSize="11"
                                                       Canvas.Left="{Binding LabelX}"
                                                       Canvas.Top="{Binding LabelY}"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding SelectedWorkflow.Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                Style="{StaticResource WorkflowNodeBorderStyle}"
                                                MouseLeftButtonDown="WorkflowNode_MouseLeftButtonDown"
                                                MouseMove="WorkflowNode_MouseMove"
                                                MouseLeftButtonUp="WorkflowNode_MouseLeftButtonUp">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Auto colour" Tag="Auto" Click="WorkflowNodeColor_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="Blue" Tag="Blue" Click="WorkflowNodeColor_Click"/>
                                                    <MenuItem Header="Green" Tag="Green" Click="WorkflowNodeColor_Click"/>
                                                    <MenuItem Header="Amber" Tag="Amber" Click="WorkflowNodeColor_Click"/>
                                                    <MenuItem Header="Rose" Tag="Rose" Click="WorkflowNodeColor_Click"/>
                                                    <MenuItem Header="Slate" Tag="Slate" Click="WorkflowNodeColor_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"/>
                                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource LineNumberForegroundBrush}" FontSize="11" Text="{Binding Kind}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource WorkflowPanelBorderStyle}" Padding="8,5">
                <TextBlock Text="{Binding StatusText}"/>
            </Border>
        </Grid>

        <Border Grid.Column="4" Style="{StaticResource WorkflowPanelBorderStyle}" IsEnabled="{Binding HasSelectedWorkflow}">
            <TabControl>
                <TabItem Header="Workflow">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                        <StackPanel>
                            <TextBlock Text="Workflow Details" Style="{StaticResource WorkflowSectionTitleStyle}"/>
                            <TextBlock Text="Name"/>
                            <TextBox Margin="0,3,0,8" Text="{Binding SelectedWorkflow.Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Category"/>
                                    <TextBox Margin="0,3,0,0" Text="{Binding SelectedWorkflow.Category, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Trigger"/>
                                    <ComboBox Margin="0,3,0,0" ItemsSource="{Binding TriggerTypes}" SelectedItem="{Binding SelectedWorkflow.Trigger, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Description" Margin="0,8,0,0"/>
                            <TextBox Style="{StaticResource MultilineTextBoxStyle}"
                                     Height="104"
                                     Margin="0,3,0,0"
                                     Text="{Binding SelectedWorkflow.Description, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Node">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                        <StackPanel>
                            <TextBlock Text="Nodes" Style="{StaticResource WorkflowSectionTitleStyle}"/>
                            <ListBox Height="120"
                                     ItemsSource="{Binding SelectedWorkflow.Nodes}"
                                     SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                     DisplayMemberPath="Summary"/>

                            <Grid Margin="0,8,0,0" IsEnabled="{Binding HasSelectedNode}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Kind"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding NodeKinds}" SelectedItem="{Binding SelectedNode.Kind, Mode=TwoWay}"/>

                                <TextBlock Grid.Row="1" Margin="0,7,8,0" VerticalAlignment="Center" Text="Title"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" Text="{Binding SelectedNode.Title, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2" Margin="0,7,8,0" VerticalAlignment="Center" Text="Colour"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" ItemsSource="{Binding NodeColors}" SelectedItem="{Binding SelectedNode.Color, Mode=TwoWay}"/>
                            </Grid>

                            <StackPanel Margin="0,8,0,0" IsEnabled="{Binding HasSelectedNode}">
                                <TextBlock Text="Goal"/>
                                <TextBox Style="{StaticResource MultilineTextBoxStyle}"
                                         Height="50"
                                         Margin="0,3,0,8"
                                         Text="{Binding SelectedNode.Goal, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Instructions"/>
                                <TextBox Style="{StaticResource MultilineTextBoxStyle}"
                                         Height="74"
                                         Margin="0,3,0,8"
                                         Text="{Binding SelectedNode.Instructions, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Expected output"/>
                                <TextBox Style="{StaticResource MultilineTextBoxStyle}"
                                         Height="54"
                                         Margin="0,3,0,8"
                                         Text="{Binding SelectedNode.ExpectedOutput, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Checklist"/>
                                <TextBox Style="{StaticResource MultilineTextBoxStyle}"
                                         Height="86"
                                         Margin="0,3,0,8"
                                         Text="{Binding SelectedNode.ChecklistText, UpdateSourceTrigger=LostFocus}"/>

                                <TextBlock Text="Notes"/>
                                <TextBox Style="{StaticResource MultilineTextBoxStyle}"
                                         Height="64"
                                         Margin="0,3,0,0"
                                         Text="{Binding SelectedNode.Description, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Expander Header="Position and size" Margin="0,10,0,0" IsEnabled="{Binding HasSelectedNode}">
                                <StackPanel Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="X" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Margin="5,0,0,0" Text="{Binding SelectedNode.X, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="4" Margin="5,0,0,0" Text="{Binding SelectedNode.Y, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Row="1" Text="W" Margin="0,6,0,0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="5,6,0,0" Text="{Binding SelectedNode.Width, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="H" Margin="0,6,0,0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="4" Margin="5,6,0,0" Text="{Binding SelectedNode.Height, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Left" Width="48" Margin="0,0,4,0" Click="NudgeNodeLeft_Click"/>
                                        <Button Content="Up" Width="40" Margin="0,0,4,0" Click="NudgeNodeUp_Click"/>
                                        <Button Content="Down" Width="50" Margin="0,0,4,0" Click="NudgeNodeDown_Click"/>
                                        <Button Content="Right" Width="52" Click="NudgeNodeRight_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Connection">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Connections" Style="{StaticResource WorkflowSectionTitleStyle}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Add" Width="50" Margin="0,0,4,0" Click="AddLink_Click" IsEnabled="{Binding CanCreateLink}"/>
                                    <Button Content="Remove" Width="68" Click="RemoveLink_Click" IsEnabled="{Binding HasSelectedLink}"/>
                                </StackPanel>
                            </DockPanel>

                            <ListBox Height="138"
                                     ItemsSource="{Binding SelectedWorkflow.Links}"
                                     SelectedItem="{Binding SelectedLink, Mode=TwoWay}"
                                     DisplayMemberPath="Summary"/>

                            <Grid Margin="0,8,0,0" IsEnabled="{Binding HasSelectedLink}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="From"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding SelectedWorkflow.Nodes}"
                                          DisplayMemberPath="Summary"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedLink.FromNodeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Margin="0,7,8,0" VerticalAlignment="Center" Text="To"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,7,0,0"
                                          ItemsSource="{Binding SelectedWorkflow.Nodes}"
                                          DisplayMemberPath="Summary"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedLink.ToNodeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2" Margin="0,7,8,0" VerticalAlignment="Center" Text="Label"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" Text="{Binding SelectedLink.Label, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
